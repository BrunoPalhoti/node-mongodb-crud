# Copie para .env e ajuste conforme seu ambiente. Nao versione o .env.

# Conexao com o MongoDB local. Sem usuario/senha porque uma instalacao
# local padrao roda sem autenticacao habilitada.
MONGODB_URI=mongodb://127.0.0.1:27017

# Banco usado pela API.
MONGODB_DB=fakestore_lab

# Banco usado por verificacoes destrutivas (seed de teste, deleteMany etc.).
# Mantido separado para nunca mexer em dados que voce queira preservar.
MONGODB_DB_TEST=fakestore_lab_test

PORT=3000
NODE_ENV=development

# Politica de paginacao das listagens (topicos 1.2 e 1.12).
DEFAULT_LIMIT=20
MAX_LIMIT=100
